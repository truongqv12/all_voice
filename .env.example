# Comma-separated list of valid API keys (sent as: Authorization: Bearer <key>)
API_KEYS=dev-key

# Execution device for backends that support it: cpu | cuda | auto
# cpu  -> VieNeu runs on ONNX Runtime (torch-free, fastest cold start)
# cuda -> VieNeu auto-switches to the PyTorch engine (requires the [gpu] extra)
DEVICE=cpu

# Which registered backend answers OpenAI-style model names it does not recognise.
DEFAULT_BACKEND=vieneu

# Max concurrent CPU-bound jobs (shared by TTS synthesis AND ASR transcription;
# keep near physical core count).
MAX_CONCURRENCY=2

# Speech-to-text (needs the `asr` extra: `uv sync --extra asr`).
# faster-whisper model: tiny | base | small | medium | large-v3, or a CTranslate2
# repo id. Default `small`; downloaded on the first transcribe request (~0.5GB).
ASR_MODEL=small
# CTranslate2 compute type: int8 (CPU, default) | float16 (CUDA).
ASR_COMPUTE_TYPE=int8

# English presets (needs the `en` extra + `espeak-ng` + `bash scripts/fetch-kokoro.sh`).
# Registers only when the model files below exist; a missing asset is skipped safely.
ENABLE_KOKORO=true
# KOKORO_MODEL_PATH=models/kokoro/kokoro-v1.0.int8.onnx
# KOKORO_VOICES_PATH=models/kokoro/voices-v1.0.bin
# KOKORO_DEFAULT_VOICE=af_heart

# Japanese presets (needs the `ja` extra + `bash scripts/fetch-voicevox.sh`).
# Registers only when the dict dir + >=1 VVM exist. Credit the character on release.
ENABLE_VOICEVOX=true
# VOICEVOX_DICT_DIR=models/voicevox/open_jtalk_dic_utf_8-1.11
# VOICEVOX_VVM_DIR=models/voicevox/vvms
# VOICEVOX_ONNXRUNTIME=            # empty = use the one bundled with voicevox_core
# VOICEVOX_SPEAKER_ALLOWLIST=      # empty = expose every style; else "3,uuid:5"

HOST=0.0.0.0
# 8123 avoids 8000/8080 (common + often in Windows' reserved ranges -> WinError 10013).
PORT=8123

# App log verbosity: DEBUG | INFO | WARNING | ERROR.
# INFO: startup summary + one line per request (with latency) + synthesis detail + 500 tracebacks.
LOG_LEVEL=INFO

# Where the rotating log file (app.log, 5MB x 5) is written, for post-crash tracing.
# Logs always go to stdout too. Set empty (LOG_DIR=) to disable the file.
LOG_DIR=logs

# Optional: where model weights are cached (default: ~/.cache/huggingface/hub).
# HF_HOME=D:/youtube/all_voice/data/hf
