# Comma-separated list of valid API keys (sent as: Authorization: Bearer <key>)
API_KEYS=dev-key

# Execution device for backends that support it: cpu | cuda | auto
# cpu  -> VieNeu runs on ONNX Runtime (torch-free, fastest cold start)
# cuda -> VieNeu auto-switches to the PyTorch engine (requires the [gpu] extra)
DEVICE=cpu

# Which registered backend answers OpenAI-style model names it does not recognise.
DEFAULT_BACKEND=vieneu

# Max concurrent CPU-bound jobs (shared by TTS synthesis AND ASR transcription;
# keep near physical core count).
MAX_CONCURRENCY=2

# Speech-to-text (needs the `asr` extra: `uv sync --extra asr`).
# faster-whisper model: tiny | base | small | medium | large-v3, or a CTranslate2
# repo id. Default `small`; downloaded on the first transcribe request (~0.5GB).
ASR_MODEL=small
# CTranslate2 compute type: int8 (CPU, default) | float16 (CUDA).
ASR_COMPUTE_TYPE=int8

# English presets (needs the `en` extra + `espeak-ng` + `bash scripts/fetch-kokoro.sh`).
# Registers only when the model files below exist; a missing asset is skipped safely.
ENABLE_KOKORO=true
# KOKORO_MODEL_PATH=models/kokoro/kokoro-v1.0.int8.onnx
# KOKORO_VOICES_PATH=models/kokoro/voices-v1.0.bin
# KOKORO_DEFAULT_VOICE=af_heart

# Japanese presets (needs the `ja` extra + `bash scripts/fetch-voicevox.sh`).
# Registers only when the dict dir + >=1 VVM exist. Credit the character on release.
ENABLE_VOICEVOX=true
# VOICEVOX_DICT_DIR=models/voicevox/open_jtalk_dic_utf_8-1.11
# VOICEVOX_VVM_DIR=models/voicevox/vvms
# VOICEVOX_ONNXRUNTIME=            # default: models/voicevox/onnxruntime/lib/libvoicevox_onnxruntime.so (from fetch-voicevox.sh); empty = a runtime already on the loader path
# VOICEVOX_SPEAKER_ALLOWLIST=      # empty = expose every style; else "3,uuid:5"

# Voice previews ("nghe thử"): per-voice sample mp3s served from GET /v1/voices.
# PREVIEWS_DIR: cache dir (safe to delete; regenerates). Default data/previews.
# PREVIEW_WARM_ON_STARTUP: warm default backend presets + clones at boot (bg thread).
# PREVIEW_CONCURRENCY: preview-only CPU budget, kept off MAX_CONCURRENCY so previews
#   never starve paid /v1/audio/speech + ASR. 1 = one preview synth at a time.
# PREVIEW_TEXT_VI/EN/JA: override the sample sentence per language (empty = built-in).
# PREVIEWS_DIR=data/previews
# PREVIEW_WARM_ON_STARTUP=true
# PREVIEW_CONCURRENCY=1
# PREVIEW_TEXT_VI=
# PREVIEW_TEXT_EN=
# PREVIEW_TEXT_JA=

# Bind address. Default 127.0.0.1 (loopback) so the API stays HIDDEN behind nginx +
# Cloudflare Tunnel — the intended public topology (docs/deployment.md). nginx (also
# on localhost) is the only thing that reaches it. Set 0.0.0.0 ONLY for a private
# LAN dev box you trust; never on the public deploy (that exposes the un-edged API).
HOST=127.0.0.1
# App's loopback port. On the public deploy nginx fronts the API: nginx listens on the
# port the Cloudflare Tunnel targets and proxies to this INTERNAL port
# (deploy/nginx.conf.example: nginx :8123 -> app :8124). 8124 avoids 8000/8080 (common,
# often in Windows' reserved ranges -> WinError 10013).
PORT=8124

# ── Public anonymous tier + abuse gate (Stage 1) ─────────────────────────────
# ANON_ENABLED=true: /v1/audio/speech, /v1/audio/stream and /v1/audio/transcriptions
# run WITHOUT a key (ANON tier, rate + daily budget + admission queue). A valid key
# in API_KEYS is the higher TRUSTED tier (no per-request limits). Clone CRUD stays
# key-only; discovery (/v1/voices, /v1/models, previews) is public. false = key-only.
# IMPORTANT: keep WORKERS=1 while anon is on — the gate is per-process in-memory +
# single-writer SQLite; the app REFUSES to start with anon + workers>1.
ANON_ENABLED=true
# Rate limit (token bucket) per IP: ANON_RATE_PER_MIN tokens/min, capacity ANON_BURST.
# ANON_RATE_PER_MIN=10
# ANON_BURST=10
# Daily cost budget per IP (UTC-day, persisted in SQLite). TTS billed in characters,
# ASR in seconds of audio — the units of real CPU cost. Refunded on any error.
# ANON_CHARS_PER_DAY=50000
# ANON_AUDIO_SECONDS_PER_DAY=1800
# QUOTA_DB_PATH=data/quota.db
# Per-request caps: buffered speech chars (long text -> use /v1/audio/stream),
# streaming total chars, and max ASR seconds for anon (over -> 413 before any CPU).
# ANON_MAX_CHARS_BUFFERED=1200
# ANON_MAX_CHARS_STREAM=20000
# ANON_MAX_AUDIO_SECONDS=300
# Concurrency / queue: reject fast (429) instead of hanging. Wait-for-slot timeout.
# ANON_MAX_CONCURRENT_PER_IP=2
# ANON_MAX_STREAMS_PER_IP=2
# MAX_QUEUE_WAITERS=20
# REQUEST_TIMEOUT_S=90
# IP key normalisation: collapse IPv6 to /prefix (stops address rotation dodging
# the budget); TTL to evict idle IPs from the in-memory bucket map.
# IP_KEY_IPV6_PREFIX=64
# IP_MAP_TTL_S=3600

# ── Core hardening: thread caps + result cache (Stage 1) ─────────────────────
# INFERENCE_THREADS caps OMP threads — but it must be a REAL environment variable
# (the systemd unit sets it): it's read at import, before this .env is parsed, so a
# line here alone has NO effect on OMP. NOTE: the VieNeu ONNX preset may IGNORE OMP
# anyway — the real CPU cap is systemd CPUQuota / taskset (deploy/install-service.sh).
# ASR (CTranslate2) honours ASR_CPU_THREADS, which IS read from this .env.
# ASR_CPU_THREADS=4
# On-disk cache of encoded buffered-TTS results (dedup identical text+voice+format;
# streaming is never cached). Background LRU sweep to the size/count ceilings.
# RESULT_CACHE_ENABLED=true
# RESULT_CACHE_DIR=data/cache
# RESULT_CACHE_MAX_MB=512
# RESULT_CACHE_MAX_FILES=4000

# ── Public deploy (nginx + Cloudflare Tunnel) ────────────────────────────────
# API bound to 127.0.0.1 above; nginx (deploy/nginx.conf.example) serves web/ and
# proxies /v1/*; cloudflared (deploy/cloudflare-tunnel.md) exposes it with 0 inbound
# ports. Firewall the API port from the LAN too, e.g.  sudo ufw deny 8124/tcp.

# App log verbosity: DEBUG | INFO | WARNING | ERROR.
# INFO: startup summary + one line per request (with latency) + synthesis detail + 500 tracebacks.
LOG_LEVEL=INFO

# Where the rotating log file (app.log, 5MB x 5) is written, for post-crash tracing.
# Logs always go to stdout too. Set empty (LOG_DIR=) to disable the file.
LOG_DIR=logs

# Optional: where model weights are cached (default: ~/.cache/huggingface/hub).
# HF_HOME=D:/youtube/all_voice/data/hf
