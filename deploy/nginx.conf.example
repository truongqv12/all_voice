# all-voice reverse proxy — the ONLY thing that reaches the API.
#
# Topology:  Cloudflare Tunnel (cloudflared) → nginx (127.0.0.1:8080) → API (127.0.0.1:8123)
# The API binds loopback and is never exposed; nginx serves the test UI and proxies /v1/*.
#
# Install:
#   sudo apt install nginx
#   sudo mkdir -p /var/www/all-voice && sudo cp -r web/* /var/www/all-voice/
#   sudo cp deploy/nginx.conf.example /etc/nginx/sites-available/all-voice
#   sudo ln -sf /etc/nginx/sites-available/all-voice /etc/nginx/sites-enabled/all-voice
#   sudo rm -f /etc/nginx/sites-enabled/default      # drop the stock 0.0.0.0:80 server
#   sudo nginx -t && sudo systemctl reload nginx
#
# Firewall the API port from the LAN too (defence in depth — nginx already fronts it):
#   sudo ufw deny 8123/tcp

server {
    # Loopback only: cloudflared dials in here; nothing on the LAN can reach it.
    listen 127.0.0.1:8080;
    server_name _;

    # ASR uploads (Whisper) — keep in step with the app's own body-size checks.
    client_max_body_size 25m;

    # Test UI (web/index.html). SPA-style fallback so unknown paths serve the page.
    root /var/www/all-voice;
    index index.html;
    location / {
        try_files $uri /index.html;
    }

    location /v1/ {
        proxy_pass http://127.0.0.1:8123;
        proxy_http_version 1.1;

        # Real client IP for the app's per-IP gate. nginx is the loopback peer, so
        # the app trusts CF-Connecting-IP ONLY on this hop (loopback-gate); a spoofed
        # header from a direct caller is ignored. cloudflared sets it from the edge.
        proxy_set_header CF-Connecting-IP $http_cf_connecting_ip;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Stream MP3 through immediately: no nginx-side buffering (the app also sends
        # X-Accel-Buffering: no). Without this, long reads get gathered and can trip
        # Cloudflare's 524 timeout before the first byte arrives.
        proxy_buffering off;
        proxy_request_buffering off;

        # A long buffered synth or transcription can take a while on CPU; allow it.
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}
